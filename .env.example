# =============================================================================
# swap-split-deposit — zero-dust, venue-independent DeFi deposit flows.
# Copy to `.env`; NEVER commit `.env`.
#
# ROLES:
#   * OPERATOR / RELAYER — EOA delegated to Calibur (EIP-7702). Broadcasts the
#       gasless flows, pays their gas, is the EIP-3009 `to` / Permit2 spender.
#   * USER / PAYER       — a DIFFERENT plain EOA. Holds the funds. Signs the
#       off-chain authorizations (gasless mode) or sends its own tx (user modes).
# =============================================================================

# --- Network -----------------------------------------------------------------
# A public endpoint that works: https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_RPC_URL=
# For the real-venue fork tests (0x / Fly). Any archive-capable mainnet RPC.
# MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com

# --- Keys (secrets — never commit) --------------------------------------------
OPERATOR_PRIVATE_KEY=
# Scripts read PRIVATE_KEY for the relayer; set equal to OPERATOR_PRIVATE_KEY.
PRIVATE_KEY=
USER_PRIVATE_KEY=
# Etherscan API key (forge --verify).
ETHERSCAN_API_KEY=
# Only for the 0x mainnet-fork test (script/zerox_quote.sh). Fly is keyless.
# ZEROX_API_KEY=

# --- Contracts (defaults for Sepolia; script constants cover the rest) --------
USDC_SEPOLIA=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
CALIBUR_IMPLEMENTATION=0x000000009B1D0aF20D8C6d0A44e162d11F9b8f00
# OUR verified SplitForwarder (run / runWithPermit / permitAndRun):
DEPOSIT_FORWARDER=0x28E815496471724e7DBA95D1a11b014110Cdb2FC
# The ORIGINAL, unmodified Layerswap depository (deposit target):
LAYERSWAP_DEPOSITORY=0xbc519fde36D45bF402d6FF40D4968AAf2ad3D0b4

# --- Flow parameters -----------------------------------------------------------
# FUNDING_MODE: gasless | user-erc20 | user-eth   (per-run, usually on the CLI)
# FUNDING_MODE=gasless
# ERC20_AUTH (user-erc20 only): permit2 (default) | 2612 (permitAndRun, no approve)
# ERC20_AUTH=permit2
DEPOSIT_RECEIVER=
FEE_RECIPIENT=
# ERC-20 modes input (USDC 6dp; 10 USDC):
AMOUNT_IN=10000000
# user-eth mode input (wei; 0.002 ETH):
# AMOUNT_ETH=2000000000000000
# Fee legs, in bips (12.34%). Flow1 has no fee leg (fee on destination chain).
FEE_BPS=1234
# Per-leg slippage tolerance (revert guard only; swaps are exact-in).
SLIPPAGE_BPS=100
# Uniswap v3 pool tier for USDC/WETH (0.05% is the liquid Sepolia pool):
# POOL_FEE=500
# Bonus plain-token flow input (wei of WETH):
# AMOUNT_WETH=1000000000000000
# Executor override (defaults to addr(PRIVATE_KEY)):
# CALIBUR_EXECUTOR=

# --- One-time setup transactions ----------------------------------------------
# 1. Deploy the forwarder:            script/DeploySplitForwarder.s.sol
# 2. Relayer -> Calibur delegation:   script/EnableDelegation.s.sol
# 3. user-erc20 (permit2) and any Permit2 inbound need, ONCE per token, from
#    the USER's key:  token.approve(PERMIT2, max)
#    (EIP-2612 tokens via ERC20_AUTH=2612 need NO approve.)
# 4. Bonus flow additionally needs the user to hold WETH (wrap ETH once).
