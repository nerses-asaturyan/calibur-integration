# =============================================================================
# Calibur (EIP-7702) + USDC EIP-3009 + LayerswapDepository — Sepolia integration
# Copy to `.env` and fill in. NEVER commit `.env` (see .gitignore).
#
# ROLES (read the README "Roles" section):
#   * OPERATOR / EXECUTOR  — the account you DELEGATE to Calibur (EIP-7702). After
#       delegation it IS the Calibur account, executes the batch, and is the
#       EIP-3009 `to`. CALIBUR_EXECUTOR defaults to this account's address.
#   * PAYER (USER)         — a DIFFERENT account that holds USDC and SIGNS the
#       EIP-3009 authorization (signed at runtime by the deposit script).
#   They must be different accounts, else the receive is a no-op self-transfer.
# =============================================================================

# --- Network ----------------------------------------------------------------
SEPOLIA_RPC_URL=

# --- Keys (secrets — never commit) ------------------------------------------
# Operator/executor key: delegated to Calibur AND submits the execute() tx.
OPERATOR_PRIVATE_KEY=
# The deposit script reads PRIVATE_KEY for broadcasting; in the EIP-7702 flow set
# it equal to OPERATOR_PRIVATE_KEY (the delegated account self-calls execute).
PRIVATE_KEY=
# Payer key: the deposit script signs the EIP-3009 authorization with this at
# runtime (v/r/s are NOT stored in env). Real users would sign in their wallet.
USER_PRIVATE_KEY=

# --- Public data (defaults pre-filled; verify before mainnet/other use) -----
# Calibur smart-wallet singleton (same address on all chains incl. Sepolia).
CALIBUR_IMPLEMENTATION=0x000000009B1D0aF20D8C6d0A44e162d11F9b8f00
USDC_SEPOLIA=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
LAYERSWAP_DEPOSITORY=0xbc519fde36D45bF402d6FF40D4968AAf2ad3D0b4

# --- Flow parameters --------------------------------------------------------
# Calibur account address (= operator address). Optional: defaults to the
# address derived from PRIVATE_KEY (the self-delegated EIP-7702 account).
CALIBUR_EXECUTOR=
# Optional cross-check; if set, must equal addr(USER_PRIVATE_KEY).
USER_ADDRESS=
DEPOSIT_RECEIVER=
# USDC has 6 decimals: 10 USDC = 10000000
AMOUNT_IN=10000000

# --- Dynamic per-run values (handled by the deposit script) ------------------
# DEPOSIT_ID is RANDOM each run. Set it only to pin a specific id:
# DEPOSIT_ID=0x...
# validBefore (now + 10 min), validAfter (0), AUTH_NONCE, AUTH_V/R/S are all
# generated/signed at runtime — do NOT set them here.
