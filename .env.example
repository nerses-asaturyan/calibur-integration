# =============================================================================
# Calibur (EIP-7702) + USDC EIP-3009 + LayerswapDepository — Sepolia integration
# Copy to `.env` and fill in. NEVER commit `.env` (see .gitignore).
#
# ROLES (read the README "Roles" section):
#   * OPERATOR / EXECUTOR  — the account you DELEGATE to Calibur (EIP-7702). After
#       delegation it IS the Calibur account, executes the batch, and is the
#       EIP-3009 `to`. CALIBUR_EXECUTOR defaults to this account's address.
#   * PAYER (USER)         — a DIFFERENT account that holds USDC and SIGNS the
#       EIP-3009 authorization (signed at runtime by the deposit script).
#   They must be different accounts, else the receive is a no-op self-transfer.
# =============================================================================

# --- Network ----------------------------------------------------------------
# A public endpoint that works: https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_RPC_URL=

# --- Keys (secrets — never commit) ------------------------------------------
# Operator/executor key: delegated to Calibur AND submits the execute() tx.
OPERATOR_PRIVATE_KEY=
# The deposit script reads PRIVATE_KEY for broadcasting; in the EIP-7702 flow set
# it equal to OPERATOR_PRIVATE_KEY (the delegated account self-calls execute).
PRIVATE_KEY=
# Payer key: the deposit script signs the EIP-3009 authorization with this at
# runtime (v/r/s are NOT stored in env). Real users would sign in their wallet.
USER_PRIVATE_KEY=
# Etherscan API key (contract verification via `forge script --verify`).
ETHERSCAN_API_KEY=

# --- Public data (defaults pre-filled; verify before mainnet/other use) -----
# Calibur smart-wallet singleton (same address on all chains incl. Sepolia).
CALIBUR_IMPLEMENTATION=0x000000009B1D0aF20D8C6d0A44e162d11F9b8f00
USDC_SEPOLIA=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# OUR deployment (verified; has depositERC20All -> zero-dust flows).
# The original Layerswap depository (no depositERC20All) is
# 0xbc519fde36D45bF402d6FF40D4968AAf2ad3D0b4 — the base CaliburDeposit flow
# works against either.
LAYERSWAP_DEPOSITORY=0x4fFFC89c52dD080d1eEEc3Ccd546602c0f1720E8

# --- Flow parameters --------------------------------------------------------
# Calibur account address (= operator address). Optional: defaults to the
# address derived from PRIVATE_KEY (the self-delegated EIP-7702 account).
CALIBUR_EXECUTOR=
# Optional cross-check; if set, must equal addr(USER_PRIVATE_KEY).
USER_ADDRESS=
DEPOSIT_RECEIVER=
# USDC has 6 decimals: 10 USDC = 10000000
AMOUNT_IN=10000000
# Depository owner for DeployDepository.s.sol (optional; defaults to addr(PRIVATE_KEY)).
# DEPOSITORY_OWNER=

# --- Dynamic per-run values (handled by the deposit script) ------------------
# DEPOSIT_ID is RANDOM each run. Set it only to pin a specific id:
# DEPOSIT_ID=0x...
# validBefore (now + 10 min), validAfter (0), AUTH_NONCE, AUTH_V/R/S are all
# generated/signed at runtime — do NOT set them here.

# =============================================================================
# DeFi flow scripts — extra vars (shared by CaliburRouterFlow.s.sol and
# CaliburMultiPairFlow.s.sol). Both are gasless-in -> multi-pool Uniswap chain ->
# fee payout + ZERO-DUST Layerswap deposit via depositERC20All, in ONE atomic
# Calibur batch. CaliburMultiPairFlow additionally does a REAL Aave v3
# supply+withdraw through the WETH9/aaveWETH bridge pool.
# =============================================================================
# Uniswap / Aave infra on Sepolia (defaults pre-filled in the scripts; override if needed).
WETH_SEPOLIA=0xfFf9976782d46CC05630D1f6eBAb18b2324d6B14
UNI_SEPOLIA=0x1f9840a85d5aF5bf1D1762F925BDADdC4201F984
UNIVERSAL_ROUTER=0x3A9D48AB9751398BbFa63ad67599Bb04e4BdF98b
UNISWAP_QUOTER=0xEd1f6473345F45b75F8179591dd5bA1888cf2FB3
# AAVE_POOL_SEPOLIA=0x6Ae43d3271ff6888e7Fc43Fd7321a503ff738951
# AAVE_WETH_SEPOLIA=0xC558DBdd856501FCd9aaF1E62eae57A9F0629a3c   # unlimited supply cap
# Uniswap v3 pool fee tiers (defaults = the liquid Sepolia pools):
# CaliburRouterFlow:    POOL_FEE_A..D (USDC/WETH 3000, WETH/UNI 3000, UNI/WETH 500, WETH/USDC 500)
# CaliburMultiPairFlow: POOL_FEE_1..4 (same pools) + POOL_FEE_AAVE (WETH/aaveWETH 3000)
# POOL_FEE_A=3000
# POOL_FEE_B=3000
# POOL_FEE_C=500
# POOL_FEE_D=500
# POOL_FEE_1=3000
# POOL_FEE_2=3000
# POOL_FEE_3=500
# POOL_FEE_4=500
# POOL_FEE_AAVE=3000
# Per-leg slippage tolerance in bps (100 = 1%).
SLIPPAGE_BPS=100
# Dual payout: a small absolute fee (USDC, 6dp) to this EOA; remainder -> Layerswap.
# FEE_RECIPIENT must differ from BOTH keys in CaliburMultiPairFlow (3-EOA rule).
FEE_RECIPIENT=
# Fee in USDC units. Must be < the guaranteed floor output or the run reverts.
FEE_AMOUNT=100000
# CaliburNativeDualFlow.s.sol only — native-ETH dual payout (no depository).
# PAYOUT_EOA_1 gets PAYOUT_SPLIT_BPS of the final ETH (defaults to FEE_RECIPIENT);
# PAYOUT_EOA_2 gets the SWEEP remainder (defaults to the payer — "buy gas with USDC").
# PAYOUT_EOA_1=
# PAYOUT_EOA_2=
# PAYOUT_SPLIT_BPS=1000
