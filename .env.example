# =============================================================================
# Gasless & user-sent DeFi deposit flows — Sepolia PoC. Copy to `.env`; NEVER commit `.env`.
#
# ROLES:
#   * OPERATOR / RELAYER — EOA delegated to Calibur (EIP-7702). Broadcasts the
#       gasless flows, pays their gas, is the EIP-3009 `to` / Permit2 spender.
#   * USER / PAYER       — a DIFFERENT plain EOA. Holds the funds. Signs the
#       off-chain authorizations (gasless modes) or sends its own tx (user modes).
# =============================================================================

# --- Network -----------------------------------------------------------------
# A public endpoint that works: https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_RPC_URL=

# --- Keys (secrets — never commit) --------------------------------------------
OPERATOR_PRIVATE_KEY=
# Scripts read PRIVATE_KEY for the relayer; set equal to OPERATOR_PRIVATE_KEY.
PRIVATE_KEY=
USER_PRIVATE_KEY=
# Etherscan API key (forge --verify).
ETHERSCAN_API_KEY=

# --- Contracts (defaults for Sepolia; script constants cover the rest) --------
USDC_SEPOLIA=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
CALIBUR_IMPLEMENTATION=0x000000009B1D0aF20D8C6d0A44e162d11F9b8f00
# OUR verified deployment (original Layerswap contract + depositERC20All):
LAYERSWAP_DEPOSITORY=0x4fFFC89c52dD080d1eEEc3Ccd546602c0f1720E8
# Optional overrides (script defaults are the canonical Sepolia deployments):
# WETH_SEPOLIA / UNIVERSAL_ROUTER / UNISWAP_QUOTER / PERMIT2 / MULTICALL3

# --- Flow parameters -----------------------------------------------------------
# FUNDING_MODE: gasless | user-erc20 | user-eth   (per-run, usually on the CLI)
# FUNDING_MODE=gasless
DEPOSIT_RECEIVER=
FEE_RECIPIENT=
# ERC-20 modes input (USDC 6dp; 10 USDC):
AMOUNT_IN=10000000
# user-eth mode input (wei; 0.002 ETH):
# AMOUNT_ETH=2000000000000000
# Fee legs, in bips (12.34%). Flow1 has no fee leg (fee on destination chain).
FEE_BPS=1234
# Per-leg slippage tolerance (revert guard only; swaps are exact-in).
SLIPPAGE_BPS=100
# Uniswap v3 pool tier for USDC/WETH (0.05% is the liquid Sepolia pool):
# POOL_FEE=500
# Bonus plain-token flow input (wei of WETH):
# AMOUNT_WETH=1000000000000000
# Executor override (defaults to addr(PRIVATE_KEY)):
# CALIBUR_EXECUTOR=
# Depository owner for DeployDepository.s.sol (defaults to addr(PRIVATE_KEY)):
# DEPOSITORY_OWNER=

# --- One-time setup transactions ----------------------------------------------
# 1. Relayer -> Calibur delegation:   script/EnableDelegation.s.sol
# 2. user-erc20 flows 2&3 and any Permit2 inbound need, ONCE per token, from
#    the USER's key:  token.approve(PERMIT2, max)
# 3. Bonus flow additionally needs the user to hold WETH (wrap ETH once).

# EXPERIMENT branch only — BalanceForwarder (bridge to the ORIGINAL depository):
# DEPOSIT_FORWARDER=0x3eA40608b36AC87dADBd1b32D3a2668997ffDa3f
# LAYERSWAP_DEPOSITORY should point at the ORIGINAL 0xbc519fde36D45bF402d6FF40D4968AAf2ad3D0b4 here.
